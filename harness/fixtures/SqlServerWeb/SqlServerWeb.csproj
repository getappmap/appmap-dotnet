<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ASP.NET Core + EF Core against SQL Server (Microsoft.Data.SqlClient) -
       the provider that exposed the SqlHooks partial-load bug, which SQLite
       never would. No AppMap reference: the agent attaches zero-touch. The
       connection string comes from ConnectionStrings__Default (set by CI). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SqlServerWeb</RootNamespace>
    <!-- NOT invariant: Microsoft.Data.SqlClient resolves a culture (en-US)
         during SqlConnection.Open(), which throws CultureNotFoundException in
         globalization-invariant mode. (The SQLite fixtures can stay invariant.) -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
  </ItemGroup>

</Project>
