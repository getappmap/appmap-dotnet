<?xml version="1.0" encoding="utf-8"?>
<!-- Classic ASP.NET (System.Web) app with NO AppMap source reference: the
     agent attaches purely by registering its IHttpModule here. The DLLs are
     dropped into bin/ by the CI job. -->
<configuration>
  <system.webServer>
    <modules>
      <add name="AppMap" type="AppMap.SystemWeb.AppMapHttpModule, AppMap.SystemWeb" />
    </modules>
  </system.webServer>
</configuration>
