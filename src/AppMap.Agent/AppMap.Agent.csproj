<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 unlocks .NET Framework 4.6.2+, .NET Core 2.x+, and Mono. -->
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AppMap</RootNamespace>
    <Description>AppMap agent for .NET: records code execution to AppMap JSON files.</Description>
    <PackageId>AppMap.Agent</PackageId>
    <Authors>AppMap, Inc.</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/getappmap/appmap-dotnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
  </ItemGroup>

  <!-- Inbox on net8.0; packages on netstandard2.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AppMap.Attributes/AppMap.Attributes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AppMap.Agent.Tests" />
  </ItemGroup>

</Project>
